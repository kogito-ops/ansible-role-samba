#
# {{ ansible_managed }}
#

[libdefaults]
    default_realm = {{ samba_domain_member.realm | upper }}
    dns_lookup_realm = true
    dns_lookup_kdc = true
    ticket_lifetime = 24h
    renew_lifetime = 7d
    forwardable = true
    rdns = false
    default_ccache_name = KEYRING:persistent:%{uid}

    # Encryption types for Active Directory compatibility
    default_tgs_enctypes = aes256-cts-hmac-sha1-96 aes128-cts-hmac-sha1-96 rc4-hmac
    default_tkt_enctypes = aes256-cts-hmac-sha1-96 aes128-cts-hmac-sha1-96 rc4-hmac
    permitted_enctypes = aes256-cts-hmac-sha1-96 aes128-cts-hmac-sha1-96 rc4-hmac

[realms]
    {{ samba_domain_member.realm | upper }} = {
{% if samba_domain_member.domain_controller is defined %}
        kdc = {{ samba_domain_member.domain_controller }}
        admin_server = {{ samba_domain_member.domain_controller }}
{% endif %}
    }

[domain_realm]
    .{{ samba_domain_member.domain | lower }} = {{ samba_domain_member.realm | upper }}
    {{ samba_domain_member.domain | lower }} = {{ samba_domain_member.realm | upper }}

[logging]
    default = FILE:{{ samba_system_logdir | default('/var/log') }}/krb5libs.log
