# RFC2307 Schema Extensions for Samba AD DC
# {{ ansible_managed }}
#
# IMPORTANT: This LDIF applies Unix/Linux attributes to AD groups and users
# - Administrator account: No uidNumber (preserves root mapping on DCs)
# - Domain Admins group: No gidNumber (preserves ID_TYPE_BOTH mapping)
# See: https://wiki.samba.org/index.php/Setting_up_Samba_as_a_Domain_Member

# Create ypServ30 domain configuration for NIS compatibility
dn: CN={{ samba_ad_info.netbios_domain_name | upper }},CN=ypservers,CN=ypServ30,CN=RpcServices,CN=System{{ _samba_ldap_suffix }}
changetype: add
objectClass: msSFU30DomainInfo
cn: {{ samba_ad_info.netbios_domain_name | upper }}
msSFU30MasterServerName: CN={{ ansible_hostname }}{{ _samba_ldap_suffix }}
msSFU30OrderNumber: 10000
msSFU30Domains: {{ samba_ad_info.netbios_domain_name | lower }}
msSFU30MaxUidNumber: {{ _samba_uid_next_counter }}
msSFU30MaxGidNumber: {{ _samba_gid_next_counter }}

# ============================================================================
# GROUP CONFIGURATIONS - Apply RFC2307 attributes to default AD groups
# ============================================================================

# Domain Users - Primary group for domain users
dn: CN=Domain Users,CN=Users{{ _samba_ldap_suffix }}
changetype: modify
add: msSFU30NisDomain
msSFU30NisDomain: {{ samba_ad_info.netbios_domain_name | lower }}
-
add: msSFU30Name
msSFU30Name: Domain Users
-
add: gidNumber
gidNumber: {{ _samba_gid_assignments.domain_users }}

# Domain Admins - NOT assigned gidNumber to preserve ID_TYPE_BOTH mapping
# Create separate Unix Admins group for Unix administration if needed
dn: CN=Domain Admins,CN=Users{{ _samba_ldap_suffix }}
changetype: modify
add: msSFU30NisDomain
msSFU30NisDomain: {{ samba_ad_info.netbios_domain_name | lower }}
-
add: msSFU30Name
msSFU30Name: Domain Admins

# Domain Computers - Machine accounts
dn: CN=Domain Computers,CN=Users{{ _samba_ldap_suffix }}
changetype: modify
add: msSFU30NisDomain
msSFU30NisDomain: {{ samba_ad_info.netbios_domain_name | lower }}
-
add: msSFU30Name
msSFU30Name: Domain Computers
-
