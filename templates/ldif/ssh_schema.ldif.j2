# SSH Key Schema Extensions for Samba AD DC
# This adds support for storing SSH public keys in Active Directory user objects
# References:
# - https://wiki.samba.org/index.php/Samba_AD_schema_extensions
# - OpenSSH LPK (LDAP Public Key) schema

# Step 1: Add sshPublicKey attribute
dn: CN=sshPublicKey,CN=Schema,CN=Configuration,{{ samba_ad_info.ad_dns_domain_name | upper | regex_replace('\.', ',DC=') | regex_replace('^', 'DC=') }}
changetype: add
objectClass: top
objectClass: attributeSchema
attributeID: 1.3.6.1.4.1.24552.500.1.1.1.13
cn: sshPublicKey
name: sshPublicKey
lDAPDisplayName: sshPublicKey
description: OpenSSH Public key for user
attributeSyntax: 2.5.5.10
oMSyntax: 4
isSingleValued: FALSE
searchFlags: 8
adminDisplayName: SSH Public Key
adminDescription: OpenSSH Public key(s) for the user
showInAdvancedViewOnly: FALSE

-
# Update schema after adding attribute
dn:
changetype: modify
add: schemaUpdateNow
schemaUpdateNow: 1
-

# Step 2: Add ldapPublicKey auxiliary class
dn: CN=ldapPublicKey,CN=Schema,CN=Configuration,{{ samba_ad_info.ad_dns_domain_name | upper | regex_replace('\.', ',DC=') | regex_replace('^', 'DC=') }}
changetype: add
objectClass: top
objectClass: classSchema
governsID: 1.3.6.1.4.1.24552.500.1.1.2.0
cn: ldapPublicKey
name: ldapPublicKey
description: OpenSSH LPK objectclass for storing SSH keys
lDAPDisplayName: ldapPublicKey
subClassOf: top
objectClassCategory: 3
defaultObjectCategory: CN=ldapPublicKey,CN=Schema,CN=Configuration,{{ samba_ad_info.ad_dns_domain_name | upper | regex_replace('\.', ',DC=') | regex_replace('^', 'DC=') }}
mayContain: sshPublicKey
adminDisplayName: LDAP Public Key
adminDescription: Auxiliary class for SSH public keys
showInAdvancedViewOnly: FALSE

-
# Update schema after adding class
dn:
changetype: modify
add: schemaUpdateNow
schemaUpdateNow: 1
-

# Step 3: Update User class to include ldapPublicKey as auxiliary class
dn: CN=User,CN=Schema,CN=Configuration,{{ samba_ad_info.ad_dns_domain_name | upper | regex_replace('\.', ',DC=') | regex_replace('^', 'DC=') }}
changetype: modify
add: auxiliaryClass
auxiliaryClass: ldapPublicKey
-

# Final schema update
dn:
changetype: modify
add: schemaUpdateNow
schemaUpdateNow: 1
-